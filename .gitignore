# ── Secrets and private config: never commit ───────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*
infra/backend.hcl
infra/*.tfvars
infra/*.tfvars.json
!infra/*.tfvars.example

