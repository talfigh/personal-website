infra/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# ── Build and test output ──────────────────────────────────────────────────
node_modules
dist
dist-ssr
playwright-report
test-results
blob-report
*.local
*.log

# ── Editor, OS, and local Claude settings ──────────────────────────────────
.claude/settings.local.json
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.sw?
